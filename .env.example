# ==============================================================================
# KHODAL FASHION — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and replace with your actual keys:
#
# 1. Google Gemini API Key (for AI Virtual Try-On & Imagen 3)
#    Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# 2. WhatsApp Business Contact Number
NEXT_PUBLIC_WHATSAPP_NUMBER=919825123456

# 3. Supabase (Dashboard → Project Settings → API Keys / Data API)
#    URL + publishable key are safe in the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
#    SECRET key: server-only. NEVER prefix with NEXT_PUBLIC_, never commit it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# 4. Email (Resend: https://resend.com). One API key is used for two things:
#    - New-enquiry alert emails sent by this website (below)
#    - Admin password-reset emails: paste the same key into Supabase as the SMTP
#      password (Authentication -> Emails -> SMTP Settings; host smtp.resend.com,
#      port 465, username "resend"). See supabase/email-templates/reset-password.html.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
#    Sender address on your verified Resend domain
ENQUIRY_FROM_EMAIL=Khodal Fashion Website <noreply@yourdomain.com>
#    Where new-enquiry alert emails are sent
ENQUIRY_ALERT_EMAIL=you@yourbusiness.com

# 5. Public site address (used for SEO: canonical links, sitemap, social previews)
NEXT_PUBLIC_SITE_URL=https://khodalfashion.com
